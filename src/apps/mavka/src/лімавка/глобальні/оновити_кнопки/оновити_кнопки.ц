дія лімавка_записати_дію_оновити_кнопки(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._оновити_кнопки,
    рідна_дія__оновити_кнопки,
  );

  мавка::записати_в_середовище(
    М,
    М.глобальне_середовище,
    лдм.назви._оновити_кнопки,
    мавка::ПРЕДМЕТ(д)
  );
}