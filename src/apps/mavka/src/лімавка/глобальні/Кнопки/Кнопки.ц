взяти визначення лімавка;

дія лімавка_встановити_модуль_Кнопки(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина
) {
  змінна прм = мавка::створити_модуль(М, лдм.назви._Кнопки);
  змінна прмпр = М.притримати_глобально(прм як *мавка::Предмет);

  мавка::записати_властивість_модуля(М, прм, лдм.назви._вверх, мавка::ПРЕДМЕТ(лдм.предмет_кнопки_вверх));
  мавка::записати_властивість_модуля(М, прм, лдм.назви._вниз, мавка::ПРЕДМЕТ(лдм.предмет_кнопки_вниз));
  мавка::записати_властивість_модуля(М, прм, лдм.назви._вліво, мавка::ПРЕДМЕТ(лдм.предмет_кнопки_вліво));
  мавка::записати_властивість_модуля(М, прм, лдм.назви._вправо, мавка::ПРЕДМЕТ(лдм.предмет_кнопки_вправо));
  мавка::записати_властивість_модуля(М, прм, лдм.назви._а, мавка::ПРЕДМЕТ(лдм.предмет_кнопки_а));
  мавка::записати_властивість_модуля(М, прм, лдм.назви._б, мавка::ПРЕДМЕТ(лдм.предмет_кнопки_б));
  мавка::записати_властивість_модуля(М, прм, лдм.назви._г, мавка::ПРЕДМЕТ(лдм.предмет_кнопки_г));
  мавка::записати_властивість_модуля(М, прм, лдм.назви._д, мавка::ПРЕДМЕТ(лдм.предмет_кнопки_д));
  мавка::записати_властивість_модуля(М, прм, лдм.назви._вибрати, мавка::ПРЕДМЕТ(лдм.предмет_кнопки_вибрати));
  мавка::записати_властивість_модуля(М, прм, лдм.назви._почати, мавка::ПРЕДМЕТ(лдм.предмет_кнопки_почати));

  // мавка::записати_властивість_модуля(
  //   М,
  //   прм,
  //   лдм.назви._Ш,
  //   мавка::ЧИСЛО(р64(лімавка_полотно_ширина(лдм.апп)))
  // );

  мавка::записати_в_середовище(
    М,
    М.глобальне_середовище,
    лдм.назви._Кнопки,
    мавка::ПРЕДМЕТ(прм)
  );

  мавка::відпустити_притриманий_глобально(М, прмпр);
}