внутрішня дія рідна_дія__отримати_час(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лдм = ЛДМ(М);

  вернути мавка::ЧИСЛО(лімавка_отримати_час(
    лдм.апп,
  ));
}

дія лімавка_записати_дію_отримати_час(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._отримати_час,
    рідна_дія__отримати_час,
  );

  мавка::записати_в_середовище(
    М,
    М.глобальне_середовище,
    лдм.назви._отримати_час,
    мавка::ПРЕДМЕТ(д)
  );
}