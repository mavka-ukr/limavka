внутрішня дія рідна_дія__спати(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лдм = ЛДМ(М);

  змінна задіяне_т: р64;

  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 0, лдм.назви._т, задіяне_т::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }

  лімавка_спати(
    лдм.апп,
    природне(задіяне_т),
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія лімавка_записати_дію_спати(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._спати,
    рідна_дія__спати,
  );

  мавка::записати_в_середовище(
    М,
    М.глобальне_середовище,
    лдм.назви._спати,
    мавка::ПРЕДМЕТ(д)
  );
}