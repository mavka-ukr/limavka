дія лімавка_встановити_модуль_Полотно(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина
) {
  змінна прм = мавка::створити_модуль(М, лдм.назви._Полотно);
  змінна прмпр = М.притримати_глобально(прм як *мавка::Предмет);

  записати_дію__Полотно_вдуга(лдм, М, прм);
  записати_дію__Полотно_веліпс(лдм, М, прм);
  записати_дію__Полотно_впрямокут(лдм, М, прм);
  записати_дію__Полотно_втрикут(лдм, М, прм);
  записати_дію__Полотно_дуга(лдм, М, прм);
  записати_дію__Полотно_еліпс(лдм, М, прм);
  записати_дію__Полотно_відмалювати(лдм, М, прм);
  записати_дію__Полотно_заповнити(лдм, М, прм);
  записати_дію__Полотно_зображення(лдм, М, прм);
  записати_дію__Полотно_прямокут(лдм, М, прм);
  записати_дію__Полотно_колір565(лдм, М, прм);
  записати_дію__Полотно_коло(лдм, М, прм);
  записати_дію__Полотно_круг(лдм, М, прм);
  записати_дію__Полотно_лінія(лдм, М, прм);
  записати_дію__Полотно_текст(лдм, М, прм);
  записати_дію__Полотно_точка(лдм, М, прм);
  записати_дію__Полотно_трикут(лдм, М, прм);

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._Ш,
    мавка::ЧИСЛО(р64(лімавка_полотно_ширина(лдм.апп)))
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._В,
    мавка::ЧИСЛО(р64(лімавка_полотно_висота(лдм.апп)))
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._КНС,
    мавка::ЧИСЛО(р64(лімавка_полотно_кнс(лдм.апп)))
  );

  мавка::записати_в_середовище(
    М,
    М.глобальне_середовище,
    лдм.назви._Полотно,
    мавка::ПРЕДМЕТ(прм)
  );

  мавка::відпустити_притриманий_глобально(М, прмпр);
}