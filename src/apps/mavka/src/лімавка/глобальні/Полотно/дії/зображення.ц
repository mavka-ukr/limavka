дія записати_дію__Полотно_зображення(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._зображення,
    рідна_дія__зображення,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._зображення,
    мавка::ПРЕДМЕТ(д)
  );
}