взяти визначення лімавка;

внутрішня дія рідна_дія__еліпс(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лдм = ЛДМ(М);

  змінна задіяне_ікс: р64;
  змінна задіяне_ігр: р64;
  змінна задіяне_рікс: р64;
  змінна задіяне_рігр: р64;
  змінна задіяне_колір: р64;

  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 0, лдм.назви._ікс, задіяне_ікс::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 1, лдм.назви._ігр, задіяне_ігр::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 2, лдм.назви._рх, задіяне_рікс::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 3, лдм.назви._ру, задіяне_рігр::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 4, лдм.назви._колір, задіяне_колір::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }

  лімавка_полотно_еліпс(
    лдм.апп,
    ціле(задіяне_ікс),
    ціле(задіяне_ігр),
    ціле(задіяне_рікс),
    ціле(задіяне_рігр),
    природне(задіяне_колір),
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__Полотно_еліпс(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._еліпс,
    рідна_дія__еліпс,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._еліпс,
    мавка::ПРЕДМЕТ(д)
  );
}