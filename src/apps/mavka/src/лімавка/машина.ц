внутрішня дія дія_перед_знищенням_кдпм(
  М: *мавка::Машина,
  кдпм: *мавка::КористувацькіДані
) {
  змінна лдм = ЛДМ(М);

  мавка::звільнити(М, лдм);
}

внутрішня дія притримавши_назву(
  М: *мавка::Машина,
  п: *мавка::Притримувач,
  т: кд
) -> *мавка::ПредметТексту {
  вернути мавка::притримавши<мавка::ПредметТексту>(
    М,
    п,
    М.створити_текст(т)
  );
}

