взяти визначення лімавка;

внутрішня дія машина_виділити_сиру_памʼять(
  М: *мавка::Машина,
  розмір: природне
) -> адреса {
  вернути лімавка_виділити(розмір);
}

внутрішня дія машина_перевиділити_сиру_памʼять(
  М: *мавка::Машина,
  значення: адреса,
  новий_розмір: природне
) -> адреса {
  вернути лімавка_перевиділити(значення, новий_розмір);
}

внутрішня дія машина_звільнити_сиру_памʼять(
  М: *мавка::Машина,
  значення: адреса
) {
  лімавка_звільнити(значення);
}

внутрішня дія машина_запанікувати(
  М: *мавка::Машина,
  повідомлення: кд
) {
  змінна з = ю8"ПАНІКА!";
  лімавка_вивести_ю8(з.дані, з.розмір);
}

внутрішня дія машина_вивести_кд(
  М: *мавка::Машина,
  колір: природне,
  значення: кд
) {
  змінна значення_ю8: ю8;
  змінна позиція_помилки: природне;
  змінна успіх: логічне;

  успіх = мавка::перекодувати_кд_в_ю8(
    М,
    значення,
    значення_ю8::адреса,
    позиція_помилки::адреса
  );
  якщо не успіх {
    вернути;
  }

  лімавка_вивести_ю8(значення_ю8.дані, значення_ю8.розмір);

  мавка::звільнити(М, значення_ю8.дані);
}

внутрішня дія машина_вивести_шлях(
  М: *мавка::Машина,
  колір: природне,
  розмір: природне,
  дані: *п8
) {
  лімавка_вивести_ю8(дані, розмір);
}

дія машина_прочитати_файл(
  М: *мавка::Машина,
  шлях_до_файлу: *мавка::ПредметДаних
) -> *мавка::ПредметДаних {
  змінна дані: *п8;
  змінна розмір: природне;
  змінна статус: ціле;

  статус = лімавка_прочитати_файл(
    шлях_до_файлу.дані,
    шлях_до_файлу.розмір,
    дані::адреса,
    розмір::адреса,
  );
  якщо статус != 0 {
    вернути пусто;
  }

  вернути мавка::створити_дані_без_копіювання(
    М,
    розмір,
    дані
  );
}

внутрішня дія машина_обробник_падінь(
  М: *мавка::Машина,
  інформація_падіння: мавка::ІнформаціяПадіння
) {
  мавка::надрукувати_інформацію_падіння(
    М,
    інформація_падіння
  );
  // лімавка_вийти(1);
}

внутрішня дія дія_перед_знищенням_кдпм(
  М: *мавка::Машина,
  кдпм: *мавка::КористувацькіДані
) {
  змінна лмд = ЛМД(М);

  мавка::звільнити(М, лмд);
}

дія лімавка_створити_машину(апп: адреса) -> *мавка::Машина {
  змінна М = лімавка_виділити(мавка::Машина.розмір) як *мавка::Машина;

  мавка::налаштувати_машину(М, мавка::Налаштування {
    .виділити_сиру_памʼять = машина_виділити_сиру_памʼять,
    .перевиділити_сиру_памʼять = машина_перевиділити_сиру_памʼять,
    .звільнити_сиру_памʼять = машина_звільнити_сиру_памʼять,
    .запанікувати = машина_запанікувати,
    .вивести_кд = машина_вивести_кд,
    .вивести_шлях = машина_вивести_шлях,
    .отримати_теку_файлу = мавка::юнікс_отримати_теку_файлу,
    .прочитати_файл = машина_прочитати_файл,
    .отримати_шлях_до_паку_з_шляху_теки_модулів = мавка::юнікс_отримати_шлях_до_паку_з_шляху_теки_модулів,
    .збити_шлях_до_модуля = мавка::юнікс_збити_шлях_до_модуля,
    .взяти_біб = пусто,
    .обробник_падінь = машина_обробник_падінь,
  });

  змінна лмд = мавка::виділити<ЛімавкаДаніМашини>(М, 1);
  лмд.апп = апп;
  лмд.назви = ЛімавкаНазви {
    ._дисплей = мавка::створити_текст(М, "дисплей"),
    ._заповнити = мавка::створити_текст(М, "заповнити"),
    ._колір = мавка::створити_текст(М, "колір"),
    ._заплвідмал = мавка::створити_текст(М, "заплвідмал"),

    .притримані = мавка::зробити_накопичувач<*мавка::Притриманий>(М, 0)
  };
  лмд.назви.притримані.покласти(М, мавка::притримати_глобально(М, лмд.назви._дисплей як *мавка::Предмет));
  лмд.назви.притримані.покласти(М, мавка::притримати_глобально(М, лмд.назви._заповнити як *мавка::Предмет));
  лмд.назви.притримані.покласти(М, мавка::притримати_глобально(М, лмд.назви._колір як *мавка::Предмет));
  лмд.назви.притримані.покласти(М, мавка::притримати_глобально(М, лмд.назви._заплвідмал як *мавка::Предмет));

  М.користувацькі_дані_пристрою = мавка::створити_користувацькі_дані(
    М,
    лмд,
    дія_перед_знищенням_кдпм
  );

  вернути М;
}

дія лімавка_знищити_машину(М: *мавка::Машина) {
  мавка::розлаштувати_машину(М);

  лімавка_звільнити(М);
}