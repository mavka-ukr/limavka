взяти визначення лімавка;

дія почати_мавку_ю8_ю8(кількість_аргументів: природне, аргументи: *ю8) -> ціле;

дія лімавка_запустити_файл(апп: адреса, дані_шляху: *п8, розмір_шляху: природне) -> ціле {
  змінна успіх: логічне;
  змінна код_помилки: ціле;
  змінна М: *мавка::Машина;
  змінна аргументи: **мавка::ПредметТексту;
  змінна інформація_падіння: мавка::ІнформаціяПадіння;
  змінна шлях_кд: кд;

  М = лімавка_створити_машину(апп);

  успіх = мавка::перекодувати_ю8_в_кд(
    М,
    ю8 { дані_шляху, розмір_шляху },
    шлях_кд::адреса,
    пусто,
  );
  якщо не успіх {
    вернути 0;
  }

  аргументи = мавка::виділити<*мавка::ПредметТексту>(М, 2);
  аргументи[0] = М.створити_текст("/мавка");
  аргументи[1] = мавка::створити_текст_без_копіювання(М, шлях_кд.розмір, шлях_кд.дані);

  код_помилки = мавка::почати(
    М,
    2,
    аргументи,
  );

  мавка::звільнити(М, аргументи);

  лімавка_знищити_машину(М);

  вернути код_помилки;
}