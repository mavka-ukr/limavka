взяти визначення лімавка;

внутрішня дія рідна_дія_заповнити_жовтим(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  лімавка_заповнити_жовтим();

  вернути мавка::НЕДІЙСНЕ;
}

дія лімавка_запустити_файл(апп: адреса, дані_шляху: *п8, розмір_шляху: природне) -> ціле {
  змінна інформація_падіння: мавка::ІнформаціяПадіння;
  змінна М: *мавка::Машина;
  змінна лдм: *ЛімавкаДаніМашини;

  М = лімавка_створити_машину(апп);
  лдм = ЛДМ(М);

  мавка::надрукувати_кд(М, "привіт я тут");

  лімавка_встановити_модуль_Полотно(лдм, М);

  змінна дія_заповнити_жовтим = мавка::створити_рідну_дію(
    М,
    мавка::створити_текст(М, "заповнити_жовтим"),
    М.пуста_послідовність,
    пусто,
    рідна_дія_заповнити_жовтим,
    пусто
  );
  мавка::записати_в_середовище(
    М,
    М.глобальне_середовище,
    мавка::створити_текст(М, "заповнити_жовтим"),
    мавка::ПРЕДМЕТ(дія_заповнити_жовтим)
  );

  змінна абсолютний_шлях_до_файлу_модуля = мавка::створити_дані(
    М,
    розмір_шляху,
    дані_шляху
  );

  мавка::взяти_файл(
    М,
    абсолютний_шлях_до_файлу_модуля,
    мавка::створити_текст(М, "тест"),
    мавка::Місцезнаходження { абсолютний_шлях_до_файлу_модуля, 0 }
  );

  мавка::надрукувати_кд(М, "привіт я тут");

  якщо мавка::отримати_інформацію_падіння(М, інформація_падіння::адреса) {
    мавка::надрукувати_інформацію_падіння(
      М,
      інформація_падіння
    );

    мавка::знищити_інформацію_падіння(М, інформація_падіння);

    вернути 1;
  }

  лімавка_знищити_машину(М);

  вернути 0;
}