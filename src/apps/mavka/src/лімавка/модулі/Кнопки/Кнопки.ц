взяти визначення лімавка;

дія записати_дію__Кнопки_оновити(лдм: *ЛімавкаДаніМашини, М: *мавка::Машина, прм: *мавка::ПредметМодуля);

дія лімавка_встановити_модуль_Кнопки(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина
) {
  змінна прм = мавка::створити_модуль(М, лдм.назви._Кнопки);
  змінна прмпр = М.притримати_глобально(прм як *мавка::Предмет);

  записати_дію__Кнопки_оновити(лдм, М, прм);

  // мавка::записати_властивість_модуля(
  //   М,
  //   прм,
  //   лдм.назви._Ш,
  //   мавка::ЧИСЛО(р64(лімавка_полотно_ширина(лдм.апп)))
  // );

  мавка::записати_в_середовище(
    М,
    М.глобальне_середовище,
    лдм.назви._Кнопки,
    мавка::ПРЕДМЕТ(прм)
  );

  мавка::відпустити_притриманий_глобально(М, прмпр);
}