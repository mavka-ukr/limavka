  мавка::записати_властивість_модуля(М, прм, лдм.назви._вправо_щойно_відпущено, мавка::ЛОГЛОГ(стан.вправо.щойно_відпущено));
  мавка::записати_властивість_модуля(М, прм, лдм.назви._а_нажато, мавка::ЛОГЛОГ(стан.а.нажато));
