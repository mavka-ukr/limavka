дія записати_дію__Кнопки_оновити(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._оновити,
    рідна_дія__оновити,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._оновити,
    мавка::ПРЕДМЕТ(д)
  );
}