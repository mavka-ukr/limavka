взяти визначення лімавка;

дія записати_дію__заповнити(лмд: *ЛімавкаДаніМашини, М: *мавка::Машина, прм: *мавка::ПредметМодуля);
дія записати_дію__заплвідмал(лмд: *ЛімавкаДаніМашини, М: *мавка::Машина, прм: *мавка::ПредметМодуля);

дія лімавка_встановити_модуль_дисплей(
  лмд: *ЛімавкаДаніМашини,
  М: *мавка::Машина
) {
  змінна прм = мавка::створити_модуль(М, лмд.назви._дисплей);
  змінна прмпр = мавка::притримати_глобально(М, прм як *мавка::Предмет);

  записати_дію__заповнити(лмд, М, прм);
  записати_дію__заплвідмал(лмд, М, прм);

  мавка::записати_в_середовище(
    М,
    М.глобальне_середовище,
    лмд.назви._дисплей,
    мавка::ПРЕДМЕТ(прм)
  );

  мавка::відпустити_притриманий_глобально(М, прмпр);
}