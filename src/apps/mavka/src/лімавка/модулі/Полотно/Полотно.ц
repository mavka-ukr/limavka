взяти визначення лімавка;

дія записати_дію__заповнити(лдм: *ЛімавкаДаніМашини, М: *мавка::Машина, прм: *мавка::ПредметМодуля);
дія записати_дію__запланувати(лдм: *ЛімавкаДаніМашини, М: *мавка::Машина, прм: *мавка::ПредметМодуля);
дія записати_дію__круг(лдм: *ЛімавкаДаніМашини, М: *мавка::Машина, прм: *мавка::ПредметМодуля);

дія лімавка_встановити_модуль_Полотно(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина
) {
  змінна прм = мавка::створити_модуль(М, лдм.назви._Полотно);
  змінна прмпр = М.притримати_глобально(прм як *мавка::Предмет);

  записати_дію__заповнити(лдм, М, прм);
  записати_дію__запланувати(лдм, М, прм);
  записати_дію__круг(лдм, М, прм);

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._Ш,
    мавка::ЧИСЛО(р64(лімавка_полотно_ширина(лдм.апп)))
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._В,
    мавка::ЧИСЛО(р64(лімавка_полотно_висота(лдм.апп)))
  );

  мавка::записати_в_середовище(
    М,
    М.глобальне_середовище,
    лдм.назви._Полотно,
    мавка::ПРЕДМЕТ(прм)
  );

  мавка::відпустити_притриманий_глобально(М, прмпр);
}