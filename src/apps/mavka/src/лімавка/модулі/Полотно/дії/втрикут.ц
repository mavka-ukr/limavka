взяти визначення лімавка;

внутрішня дія рідна_дія__втрикут(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лдм = ЛДМ(М);

  змінна задіяне_х0: р64;
  змінна задіяне_у0: р64;
  змінна задіяне_х1: р64;
  змінна задіяне_у1: р64;
  змінна задіяне_х2: р64;
  змінна задіяне_у2: р64;
  змінна задіяне_колір: р64;

  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 0, лдм.назви._х0, задіяне_х0::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 1, лдм.назви._у0, задіяне_у0::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 2, лдм.назви._х1, задіяне_х1::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 3, лдм.назви._у1, задіяне_у1::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 4, лдм.назви._х2, задіяне_х2::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 5, лдм.назви._у2, задіяне_у2::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 6, лдм.назви._колір, задіяне_колір::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }

  лімавка_полотно_втрикут(
    лдм.апп,
    ціле(задіяне_х0),
    ціле(задіяне_у0),
    ціле(задіяне_х1),
    ціле(задіяне_у1),
    ціле(задіяне_х2),
    ціле(задіяне_у2),
    природне(задіяне_колір),
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__Полотно_втрикут(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._втрикут,
    рідна_дія__втрикут,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._втрикут,
    мавка::ПРЕДМЕТ(д)
  );
}