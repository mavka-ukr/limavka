взяти визначення лімавка;

внутрішня дія рідна_дія__колір565(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лдм = ЛДМ(М);

  змінна задіяне_ч: р64;
  змінна задіяне_з: р64;
  змінна задіяне_с: р64;

  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 0, лдм.назви._ч, задіяне_ч::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 1, лдм.назви._з, задіяне_з::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 2, лдм.назви._с, задіяне_с::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }

  лімавка_полотно_колір565(
    лдм.апп,
    п8(задіяне_ч),
    п8(задіяне_з),
    п8(задіяне_с),
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__Полотно_колір565(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._колір565,
    рідна_дія__колір565,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._колір565,
    мавка::ПРЕДМЕТ(д)
  );
}