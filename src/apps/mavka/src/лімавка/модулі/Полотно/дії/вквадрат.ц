взяти визначення лімавка;

внутрішня дія рідна_дія__вквадрат(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лдм = ЛДМ(М);

  змінна задіяне_г: р64;
  змінна задіяне_в: р64;
  змінна задіяне_вис: р64;
  змінна задіяне_шир: р64;
  змінна задіяне_колір: р64;

  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 0, лдм.назви._г, задіяне_г::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 1, лдм.назви._в, задіяне_в::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 2, лдм.назви._вис, задіяне_вис::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 3, лдм.назви._шир, задіяне_шир::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 4, лдм.назви._колір, задіяне_колір::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }

  лімавка_полотно_вквадрат(
    лдм.апп,
    ціле(задіяне_г),
    ціле(задіяне_в),
    ціле(задіяне_вис),
    ціле(задіяне_шир),
    природне(задіяне_колір),
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__Полотно_вквадрат(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._вквадрат,
    рідна_дія__вквадрат,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._вквадрат,
    мавка::ПРЕДМЕТ(д)
  );
}