взяти визначення лімавка;

внутрішня дія рідна_дія__трикут(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лдм = ЛДМ(М);

  змінна задіяне_ікс0: р64;
  змінна задіяне_ігр0: р64;
  змінна задіяне_ікс1: р64;
  змінна задіяне_ігр1: р64;
  змінна задіяне_ікс2: р64;
  змінна задіяне_ігр2: р64;
  змінна задіяне_колір: р64;

  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 0, лдм.назви._ікс0, задіяне_ікс0::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 1, лдм.назви._ігр0, задіяне_ігр0::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 2, лдм.назви._ікс1, задіяне_ікс1::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 3, лдм.назви._ігр1, задіяне_ігр1::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 4, лдм.назви._ікс2, задіяне_ікс2::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 5, лдм.назви._ігр2, задіяне_ігр2::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 6, лдм.назви._колір, задіяне_колір::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }

  лімавка_полотно_трикут(
    лдм.апп,
    ціле(задіяне_ікс0),
    ціле(задіяне_ігр0),
    ціле(задіяне_ікс1),
    ціле(задіяне_ігр1),
    ціле(задіяне_ікс2),
    ціле(задіяне_ігр2),
    природне(задіяне_колір),
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__Полотно_трикут(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._трикут,
    рідна_дія__трикут,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._трикут,
    мавка::ПРЕДМЕТ(д)
  );
}