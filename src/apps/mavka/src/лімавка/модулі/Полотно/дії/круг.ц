внутрішня дія рідна_дія__круг(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лдм = ЛДМ(М);

  змінна задіяне_г = мавка::НЕДІЙСНЕ;
  змінна задіяне_в = мавка::НЕДІЙСНЕ;
  змінна задіяне_р = мавка::НЕДІЙСНЕ;
  змінна задіяне_колір = мавка::НЕДІЙСНЕ;

  мавка::знайти_задіяне(М, діяльність.задіяні, 0, лдм.назви._г, задіяне_г::адреса);
  мавка::знайти_задіяне(М, діяльність.задіяні, 1, лдм.назви._в, задіяне_в::адреса);
  мавка::знайти_задіяне(М, діяльність.задіяні, 2, лдм.назви._р, задіяне_р::адреса);
  мавка::знайти_задіяне(М, діяльність.задіяні, 3, лдм.назви._колір, задіяне_колір::адреса);

  якщо не задіяне_г.є_числом() {
    вернути мавка::НЕДІЙСНЕ;
  }
  якщо не задіяне_в.є_числом() {
    вернути мавка::НЕДІЙСНЕ;
  }
  якщо не задіяне_р.є_числом() {
    вернути мавка::НЕДІЙСНЕ;
  }
  якщо не задіяне_колір.є_числом() {
    вернути мавка::НЕДІЙСНЕ;
  }

  лімавка_полотно_круг(
    лдм.апп,
    ціле(задіяне_г.як_число()),
    ціле(задіяне_в.як_число()),
    ціле(задіяне_р.як_число()),
    природне(задіяне_колір.як_число()),
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__круг(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._круг,
    рідна_дія__круг,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._круг,
    мавка::ПРЕДМЕТ(д)
  );
}