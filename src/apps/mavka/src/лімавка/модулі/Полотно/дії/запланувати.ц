внутрішня дія рідна_дія__запланувати(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лмд = ЛМД(М);

  лімавка_полотно_запланувати(
    лмд.апп,
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__запланувати(
  лмд: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лмд.назви._запланувати,
    рідна_дія__запланувати,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лмд.назви._запланувати,
    мавка::ПРЕДМЕТ(д)
  );
}