взяти визначення лімавка;

внутрішня дія рідна_дія__текст(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лдм = ЛДМ(М);

  змінна задіяне_х: р64;
  змінна задіяне_у: р64;
  змінна задіяне_значення: ю8;
  змінна задіяне_шрифт: *мавка::ПредметТексту;
  змінна задіяне_розмір: р64;
  змінна задіяне_колір: р64;

  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 0, лдм.назви._х, задіяне_х::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 1, лдм.назви._у, задіяне_у::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_ю8(М, діяльність.задіяні, 2, лдм.назви._значення, задіяне_значення::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  змінна знайдено_задіяне_шрифт = мавка::знайти_задіяне_як_текст(М, діяльність.задіяні, 3, лдм.назви._шрифт, задіяне_шрифт::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  змінна знайдено_задіяне_розмір = мавка::знайти_задіяне_як_число(М, діяльність.задіяні, 4, лдм.назви._розмір, задіяне_розмір::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  якщо не знайдено_задіяне_розмір {
    задіяне_розмір = 1;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 5, лдм.назви._колір, задіяне_колір::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }

  змінна шрифт: природне;
  якщо не знайдено_задіяне_шрифт {
    шрифт = 0;
  } інакше якщо задіяне_шрифт.значення.рівн("4х6") {
    шрифт = 0;
  } інакше якщо задіяне_шрифт.значення.рівн("5х7") {
    шрифт = 1;
  } інакше якщо задіяне_шрифт.значення.рівн("5х8") {
    шрифт = 2;
  } інакше якщо задіяне_шрифт.значення.рівн("6х12") {
    шрифт = 3;
  } інакше якщо задіяне_шрифт.значення.рівн("6х13") {
    шрифт = 4;
  } інакше якщо задіяне_шрифт.значення.рівн("7х13") {
    шрифт = 5;
  } інакше якщо задіяне_шрифт.значення.рівн("8х13") {
    шрифт = 6;
  } інакше якщо задіяне_шрифт.значення.рівн("9х15") {
    шрифт = 7;
  } інакше якщо задіяне_шрифт.значення.рівн("10х20") {
    шрифт = 8;
  } інакше {
    мавка::звільнити(М, задіяне_значення.дані);
    вернути мавка::НЕДІЙСНЕ;  // невідомий шрифт
  }

  лімавка_полотно_текст(
    лдм.апп,
    ціле(задіяне_х),
    ціле(задіяне_у),
    задіяне_значення.дані,
    задіяне_значення.розмір,
    шрифт,
    природне(задіяне_розмір),
    природне(задіяне_колір),
  );

  мавка::звільнити(М, задіяне_значення.дані);

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__Полотно_текст(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._текст,
    рідна_дія__текст,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._текст,
    мавка::ПРЕДМЕТ(д)
  );
}