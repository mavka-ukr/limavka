внутрішня дія рідна_дія__заповнити(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лдм = ЛДМ(М);

  змінна задіяне_колір: р64;

  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 0, лдм.назви._колір, задіяне_колір::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }

  лімавка_полотно_заповнити(
    лдм.апп,
    природне(задіяне_колір)
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__Полотно_заповнити(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._заповнити,
    рідна_дія__заповнити,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._заповнити,
    мавка::ПРЕДМЕТ(д)
  );
}