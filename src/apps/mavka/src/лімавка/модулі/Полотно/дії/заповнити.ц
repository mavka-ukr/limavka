внутрішня дія рідна_дія__заповнити(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лмд = ЛМД(М);

  змінна задіяне_колір = мавка::НЕДІЙСНЕ;
  змінна знайдено_задіяне_колір: логічне;

  знайдено_задіяне_колір = мавка::знайти_задіяне(М, діяльність.задіяні, 0, лмд.назви._колір, задіяне_колір::адреса);

  якщо задіяне_колір.вид != мавка::ЗЧисло {
    вернути мавка::НЕДІЙСНЕ;
  }

  лімавка_полотно_заповнити(
    лмд.апп,
    природне(задіяне_колір.дані як р64)
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__заповнити(
  лмд: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна кількість_параметрів = природне(1);
  змінна дані_параметрів = мавка::виділити<мавка::Значення>(М, кількість_параметрів);
  дані_параметрів[0] = мавка::ПРЕДМЕТ(мавка::створити_параметр(
    М,
    лмд.назви._колір,
    пусто,
    мавка::НЕДІЙСНЕ
  ));

  змінна д = мавка::створити_рідну_дію(
    М,
    лмд.назви._заповнити,
    мавка::створити_послідовність_без_копіювання(
      М,
      кількість_параметрів,
      дані_параметрів
    ),
    пусто,
    рідна_дія__заповнити,
    пусто
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лмд.назви._заповнити,
    мавка::ПРЕДМЕТ(д)
  );
}