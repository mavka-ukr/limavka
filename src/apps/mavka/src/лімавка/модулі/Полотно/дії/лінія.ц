взяти визначення лімавка;

внутрішня дія рідна_дія__лінія(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лдм = ЛДМ(М);

  змінна задіяне_г0: р64;
  змінна задіяне_в0: р64;
  змінна задіяне_г1: р64;
  змінна задіяне_в1: р64;
  змінна задіяне_колір: р64;

  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 0, лдм.назви._г0, задіяне_г0::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 1, лдм.назви._в0, задіяне_в0::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 2, лдм.назви._г1, задіяне_г1::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 3, лдм.назви._в1, задіяне_в1::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 4, лдм.назви._колір, задіяне_колір::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }

  лімавка_полотно_лінія(
    лдм.апп,
    ціле(задіяне_г0),
    ціле(задіяне_в0),
    ціле(задіяне_г1),
    ціле(задіяне_в1),
    природне(задіяне_колір),
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__Полотно_лінія(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._лінія,
    рідна_дія__лінія,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._лінія,
    мавка::ПРЕДМЕТ(д)
  );
}