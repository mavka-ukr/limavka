взяти визначення лімавка;

внутрішня дія рідна_дія__еліпс(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лдм = ЛДМ(М);

  змінна задіяне_г: р64;
  змінна задіяне_в: р64;
  змінна задіяне_рг: р64;
  змінна задіяне_рв: р64;
  змінна задіяне_колір: р64;

  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 0, лдм.назви._г, задіяне_г::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 1, лдм.назви._в, задіяне_в::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 2, лдм.назви._рг, задіяне_рг::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 3, лдм.назви._рв, задіяне_рв::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }
  мавка::отримати_задіяне_як_число(М, діяльність.задіяні, 4, лдм.назви._колір, задіяне_колір::адреса);
  якщо М.стан_падіння {
    вернути мавка::НЕДІЙСНЕ;
  }

  лімавка_полотно_еліпс(
    лдм.апп,
    ціле(задіяне_г),
    ціле(задіяне_в),
    ціле(задіяне_рг),
    ціле(задіяне_рв),
    природне(задіяне_колір),
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__Полотно_еліпс(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна д = М.створити_рідну_дію(
    лдм.назви._еліпс,
    рідна_дія__еліпс,
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._еліпс,
    мавка::ПРЕДМЕТ(д)
  );
}