взяти визначення лімавка;

дія лімавка_встановити_модуль_Колір(
  лдм: *ЛімавкаДаніМашини,
  М: *мавка::Машина
) {
  змінна прм = мавка::створити_модуль(М, лдм.назви._Колір);
  змінна прмпр = М.притримати_глобально(прм як *мавка::Предмет);

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._БІЛИЙ,
    мавка::ЧИСЛО(ЛІМАВКА_КОЛІР_БІЛИЙ)
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._ЧОРНИЙ,
    мавка::ЧИСЛО(ЛІМАВКА_КОЛІР_ЧОРНИЙ)
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._ЧЕРВОНИЙ,
    мавка::ЧИСЛО(ЛІМАВКА_КОЛІР_ЧЕРВОНИЙ)
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._ЗЕЛЕНИЙ,
    мавка::ЧИСЛО(ЛІМАВКА_КОЛІР_ЗЕЛЕНИЙ)
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лдм.назви._СИНІЙ,
    мавка::ЧИСЛО(ЛІМАВКА_КОЛІР_СИНІЙ)
  );

  мавка::записати_в_середовище(
    М,
    М.глобальне_середовище,
    лдм.назви._Колір,
    мавка::ПРЕДМЕТ(прм)
  );

  мавка::відпустити_притриманий_глобально(М, прмпр);
}