внутрішня дія рідна_дія__заплвідмал(
  М: *мавка::Машина,
  діяльність: *мавка::Діяльність
) -> мавка::ЗначенняАбоСтанПадіння {
  змінна лмд = ЛМД(М);

  лімавка_дисплей_заплвідмал(
    лмд.апп,
  );

  вернути мавка::НЕДІЙСНЕ;
}

дія записати_дію__заплвідмал(
  лмд: *ЛімавкаДаніМашини,
  М: *мавка::Машина,
  прм: *мавка::ПредметМодуля
) {
  змінна кількість_параметрів = природне(0);
  змінна дані_параметрів: *мавка::Значення;

  змінна д = мавка::створити_рідну_дію(
    М,
    лмд.назви._заплвідмал,
    мавка::створити_послідовність_без_копіювання(
      М,
      кількість_параметрів,
      дані_параметрів
    ),
    пусто,
    рідна_дія__заплвідмал,
    пусто
  );

  мавка::записати_властивість_модуля(
    М,
    прм,
    лмд.назви._заплвідмал,
    мавка::ПРЕДМЕТ(д)
  );
}